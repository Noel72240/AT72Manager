# Modèle .env.production — copiez vers .env.production et remplissez.
# Vos valeurs actuelles sont déjà dans .env (dev) : réutilisez les mêmes URL/clés Supabase.

VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# Depuis Supabase → Settings → API
VITE_SUPABASE_URL=https://VOTRE-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Google Cloud → APIs & Services → Credentials → OAuth 2.0
# Type OBLIGATOIRE pour l'installateur : Application de bureau (Desktop)
# PAS uniquement « Application Web » avec localhost:5173
VITE_GOOGLE_CLIENT_ID=

VITE_AI_ENABLED=true
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
