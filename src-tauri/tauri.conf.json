{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AT72Manager",
  "version": "1.0.0",
  "identifier": "com.at72manager.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:production"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AT72Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost",
        "connect-src": "'self' https://*.supabase.co wss://*.supabase.co https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com https://api.openai.com http://127.0.0.1:* ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' asset: http://asset.localhost data:",
        "script-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "AT72Manager",
    "shortDescription": "Gestion atelier SAV premium — offline-first, multi-postes",
    "longDescription": "AT72Manager est un logiciel de gestion d'atelier SAV (interventions, clients, stock, devis, factures, portail client) conçu pour une utilisation quotidienne sur Windows en mode hors-ligne avec synchronisation cloud.",
    "category": "Business",
    "copyright": "Copyright © AT72Manager",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "fr-FR"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": [
          "French",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null
      },
      "allowDowngrades": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://releases.at72manager.example/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
