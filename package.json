{
  "name": "at72manager",
  "private": true,
  "version": "1.0.0",
  "description": "AT72Manager — gestion atelier SAV desktop professionnelle",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "build": "tsc -b && vite build",
    "build:production": "cross-env VITE_APP_ENV=production tsc -b && cross-env VITE_APP_ENV=production vite build --mode production",
    "build:tauri": "tauri build",
    "build:windows": "npm run prebuild:windows && tauri build",
    "build:windows:nsis": "npm run prebuild:windows && tauri build --bundles nsis",
    "build:windows:debug": "tauri build --debug",
    "prebuild:windows": "node scripts/verify-production-env.mjs && npm run version:sync && npm run icons:generate && npm run build:production",
    "verify:production": "node scripts/verify-production-env.mjs",
    "check:windows": "powershell -ExecutionPolicy Bypass -File scripts/check-windows-prerequisites.ps1",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "version:sync": "node scripts/sync-version.mjs",
    "icons:generate": "powershell -ExecutionPolicy Bypass -File scripts/prepare-app-icon.ps1 && tauri icon branding/app-icon-square.png -o src-tauri/icons",
    "vercel-build": "npm run build:portal",
    "build:portal": "cross-env VITE_PORTAL_STANDALONE=true vite build --config vite.portal.config.ts --mode portal-production && node scripts/portal-postbuild.mjs && node scripts/verify-portal-dist.mjs",
    "dev:portal": "vite --config vite.portal.config.ts --mode portal-production --port 4174",
    "preview:portal": "vite preview --config vite.portal.config.ts --outDir dist-portal --port 4173",
    "verify:portal": "node scripts/verify-portal-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "fflate": "^0.8.3",
    "framer-motion": "^12.40.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
