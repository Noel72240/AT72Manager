# Environnement : development (défaut) | production (build installateur)
# VITE_APP_ENV=development
# VITE_APP_VERSION=1.0.0

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Assistant IA (OpenAI — clé exposée côté client en dev/desktop ; préférez une Edge Function en production web)
VITE_AI_ENABLED=true
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# Google Calendar (OAuth 2.0 — Console Google Cloud)
# Pour l'app desktop Tauri : créez un client OAuth type « Application de bureau » (Desktop)
# Les redirects loopback http://127.0.0.1:* sont acceptés automatiquement.
# Pour le navigateur web uniquement : client « Application Web » + origines localhost.
VITE_GOOGLE_CLIENT_ID=
