# Copiez vers .env.production avant un build installateur Windows.
# Ces variables sont intégrées au build (Vite) — ne commitez pas de secrets réels.

VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# Supabase (projet production)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon

# Google Calendar — client OAuth « Application de bureau » (Desktop)
VITE_GOOGLE_CLIENT_ID=

# Assistant IA (optionnel — préférez une Edge Function pour la clé OpenAI)
VITE_AI_ENABLED=true
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# Futur auto-update Tauri (endpoint releases — voir docs/DESKTOP_PRODUCTION.md)
VITE_UPDATER_ENDPOINT=

# Portail client web public (liens depuis l’app desktop)
VITE_PORTAL_PUBLIC_URL=https://portal.allotech72.fr
